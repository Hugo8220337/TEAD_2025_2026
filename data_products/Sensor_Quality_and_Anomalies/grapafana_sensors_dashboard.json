                        "format": 0,
                        "rawSQL": "SELECT \n    parameter_measured, \n    AVG(drift_value) AS \"Desvio Médio\" \nFROM \n    iceberg.gold.cross_sensor_drift \nGROUP BY \n    parameter_measured \nORDER BY \n    \"Desvio Médio\" DESC"
