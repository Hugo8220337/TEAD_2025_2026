          "id": 5,
          "title": "Saúde Global dos Sensores",
          "description": "Objetivo: Uma visão geral imediata para a gestão. Mostra como está a saúde global da frota de sensores.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
