      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Perfil de Ruído e Congelamento por Sensor",
          "description": "Objetivo: Perceber porquê que os sensores estão a falhar. Para os sensores com problemas, este gráfico mostra de onde vem o erro (se são quebras de sinal, congelamentos ou picos).\nTipo de Gráfico no Grafana: Bar chart (Barras Horizontais e Empilhadas).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "trino-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "ffkhcl62sowsga"
                      },
                      "spec": {
                        "format": 0,
                        "rawSQL": "SELECT \n    sensor_name, \n    frozen_signal_count AS \"Sinais Congelados\", \n    noise_spikes_count AS \"Picos de Ruído\", \n    hardware_failures AS \"Falhas de Hardware\"\nFROM \n    iceberg.gold.sensor_health_summary\nWHERE \n    health_grade IN ('Degradado', 'Falha Crítica')\n    AND equipment_brand IN (${marca:singlequote})\nORDER BY \n    (frozen_signal_count + noise_spikes_count + hardware_failures) DESC\nLIMIT 10"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
