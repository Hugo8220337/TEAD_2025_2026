                        "rawSQL": "SELECT \n    TRIM(health_grade) as health_grade, \n    COUNT(sensor_name) as quantidade_sensores\nFROM \n    iceberg.gold.sensor_health_summary\nWHERE\n    equipment_brand IN (${marca:singlequote})\nGROUP BY \n    1\nORDER BY \n    1 ASC"
