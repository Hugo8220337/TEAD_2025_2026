                      },
                      "spec": {
                        "format": 0,
                        "rawSQL": "SELECT \n    health_grade as \"Estado\",\n    sensor_name as \"Sensor\", \n    equipment_brand as \"Marca\",\n    ROUND(null_rate_percentage, 1) as \"Tempo Desligado (%)\"\nFROM \n    iceberg.gold.sensor_health_summary\nWHERE\n    equipment_brand IN (${marca:singlequote})\nORDER BY \n    health_grade DESC, \n    null_rate_percentage DESC"
