      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Falhas por Marca",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "trino-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "ffkhcl62sowsga"
                      },
                      "spec": {
                        "format": 0,
                        "rawSQL": "WITH erros_agrupados AS (\n    SELECT \n        equipment_brand, \n        error_reason, \n        CAST(SUM(failure_count) AS DOUBLE) AS total_falhas \n    FROM \n        iceberg.gold.hardware_failures_summary \n    WHERE\n        equipment_brand IN (${marca:singlequote})\n    GROUP BY \n        equipment_brand, \n        error_reason\n)\nSELECT \n    equipment_brand,\n    error_reason,\n    total_falhas AS \"Total Falhas\",\n    -- Calcula a percentagem que este erro representa dentro do total de erros desta marca\n    ROUND((total_falhas / SUM(total_falhas) OVER (PARTITION BY equipment_brand)) * 100, 2) AS \"Percentagem de Erro\"\nFROM \n    erros_agrupados\nORDER BY \n    equipment_brand, \n    \"Percentagem de Erro\" DESC"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
